# Password hash (bcrypt) — generate with:
# python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
PULSE_PASSWORD_HASH=

# Server-side key used to sign session tokens (HMAC-SHA256). Never sent to the browser.
# At least 32 characters; changing it logs every device out. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
PULSE_SECRET_KEY=

# Session token lifetime in days (default 30)
PULSE_TOKEN_TTL_DAYS=30

# SQLite database path (absolute path recommended in production)
DATABASE_URL=/data/pulse.db

# Feed refresh interval in minutes
FETCH_INTERVAL_MINUTES=60

# Article retention in days (unsaved items older than this are purged)
RETENTION_DAYS=30

# Origins allowed by CORS, comma-separated (default: the production domain + Vite dev server)
# PULSE_ALLOWED_ORIGINS=https://pulse.julienlambs.dev,http://localhost:5173

# Set to 1 to expose the interactive API docs at /docs (local development only)
# PULSE_ENABLE_DOCS=1
