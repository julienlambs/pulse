# Password hash (bcrypt) — generate with:
# python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
PULSE_PASSWORD_HASH=

# Bearer token used by the API — any random string, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
PULSE_SECRET_KEY=

# SQLite database path (absolute path recommended in production)
DATABASE_URL=/data/pulse.db

# Feed refresh interval in minutes
FETCH_INTERVAL_MINUTES=60

# Article retention in days (unsaved items older than this are purged)
RETENTION_DAYS=30
